# Enchantee provisioning environment.
#
# Copy to .env alongside docker-compose.yml and fill in the placeholders:
#     cp .env.example .env
#
# .env itself is gitignored. Never commit real credentials.

INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=CHANGE-ME

ONEDRIVE_DATA_DIR=/media/pi/HOMEMONITOR/backup/Input

# Hostname the services are reached on. See README.md section 7.
# Grafana uses it for the absolute links it generates (alerts, share URLs);
# assets are relative, so the box stays reachable by IP whatever this says.
DOMAIN_NAME=enchantee.local

GRAFANA_USERNAME=admin
GRAFANA_PASSWORD=CHANGE-ME
# Must end in /grafana/ to match the nginx route and
# GF_SERVER_SERVE_FROM_SUB_PATH=true in docker-compose.yml.
GRAFANA_URL=%(protocol)s://%(domain)s/grafana/

TIMEZONE=Australia/Perth

# MySQL Database (for WordPress)
# No mysql service is defined in docker-compose.yml at present; these are here
# for the local WordPress test setup described below.
MYSQL_ROOT_PASSWORD=CHANGE-ME
MYSQL_DATABASE=wordpress
MYSQL_USER=wpuser
MYSQL_PASSWORD=CHANGE-ME

# WordPress publishing, used by the event_recorder container.
WP_SITE_URL=https://enchantee.org
WP_USERNAME=event_recorder_user
# WordPress application password, generated per the notes below.
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
# Whitelisting endpoint. The credentials are in the query string, so treat this
# whole value as a secret.
WP_WHITELIST_ENDPOINT=https://example.org/ewl.php?u=USERNAME&p=PASSWORD


# NOTE: After WordPress setup:
# 1. Complete WordPress installation at http://localhost:8080
# 2. Create admin user (username: admin, or your choice)
# 3. Generate Application Password: WordPress Admin -> Users -> Profile -> Application Passwords
# 4. Update WP_APP_PASSWORD above with the generated password
# 5. Update WP_USERNAME if you used a different username
