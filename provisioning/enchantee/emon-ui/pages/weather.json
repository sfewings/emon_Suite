{
  "title": "Weather",
  "cols": 2,
  "tiles": [
    {
      "title": "True wind",
      "domain": "rain",
      "span": 1,
      "compass": {
        "needles": [
          {
            "feed": "True wind / windDirection",
            "label": "TWD"
          },
          {
            "feed": "Enchantee-GPS / course",
            "label": "COG"
          }
        ]
      },
      "values": [
        {
          "feed": "True wind / windSpeed",
          "label": "TWS",
          "big": true,
          "decimals": 1
        },
        {
          "feed": "derived/wind/twa",
          "label": "TWA",
          "big": true,
          "decimals": 0
        }
      ],
      "trail": {
        "feed": "True wind / windSpeed",
        "minutes": 30
      },
      "cols": 2
    },
    {
      "title": "Apparent wind",
      "domain": "rain",
      "span": 1,
      "compass": {
        "relative": true,
        "needles": [
          {
            "feed": "derived/wind/awa",
            "label": "AWA"
          }
        ]
      },
      "values": [
        {
          "feed": "Apparent wind / windSpeed",
          "label": "AWS",
          "big": true,
          "decimals": 1
        },
        {
          "feed": "Apparent wind / windDirection",
          "label": "AWD",
          "decimals": 0
        }
      ],
      "cols": 2
    },
    {
      "title": "Air",
      "domain": "heat",
      "span": 2,
      "gone": 600,
      "values": [
        {
          "feed": "Anemometer / temperature",
          "label": "Temperature",
          "big": true,
          "decimals": 1
        },
        {
          "feed": "Anemometer / humidity",
          "label": "Humidity",
          "decimals": 0
        },
        {
          "feed": "Anemometer / pressure",
          "label": "Pressure",
          "decimals": 1
        },
        {
          "feed": "Light Banner / Bimini",
          "label": "Bimini",
          "decimals": 1
        }
      ],
      "cols": 4
    }
  ]
}
