{
  "title": "Dials",
  "tiles": [
    {
      "title": "Motor",
      "domain": "power",
      "span": 2,
      "dial": [
        {
          "feed": "SevCon / rpm",
          "label": "RPM",
          "min": -2000,
          "max": 2000,
          "unit": ""
        },
        {
          "feed": "SevCon / batteryCurrent",
          "label": "Current",
          "min": 0,
          "max": 100
        }
      ]
    },
    {
      "title": "Battery",
      "domain": "batt",
      "span": 2,
      "dial": [
        {
          "feed": "SevCon / capVoltage",
          "label": "Voltage",
          "min": 40,
          "max": 60,
          "warn": 50,
          "bad": 48,
          "decimals": 1
        },
        {
          "feed": "Main Battery / batterySoC",
          "label": "SoC",
          "min": 0,
          "max": 100,
          "warn": 30,
          "bad": 15,
          "decimals": 0
        }
      ]
    },
    {
      "title": "Temperatures",
      "domain": "heat",
      "span": 2,
      "dial": [
        {
          "feed": "SevCon / motorTemperature",
          "label": "Motor",
          "min": 0,
          "max": 100,
          "warn": 50,
          "bad": 75,
          "decimals": 0
        },
        {
          "feed": "SevCon / controllerTemperature",
          "label": "Controller",
          "min": 0,
          "max": 100,
          "warn": 50,
          "bad": 75,
          "decimals": 0
        }
      ],
      "trail": {
        "feed": "SevCon / controllerTemperature",
        "minutes": 30
      }
    }
  ]
}
