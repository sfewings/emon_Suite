#redirect http traffic to https
server {
    listen 80;
    server_name shannstainable.fewings.org;
    return 301 https://$server_name$request_uri;
}

server {
  listen 443 default ssl;
#  ssl on;
#  ssl_certificate_key ./ssl/privkey.pem;
#  ssl_certificate ./ssl/cert.pem;
  ssl_certificate_key /etc/letsencrypt/live/shannstainable.fewings.org/privkey.pem;
  ssl_certificate /etc/letsencrypt/live/shannstainable.fewings.org/fullchain.pem;

#  ssl_certificate /home/pi/.node-red/nodecerts/node-cert.pem;
#  ssl_certificate_key /home/pi/.node-red/nodecerts/node-key.pem;
  ssl_verify_depth 3;
  ssl_protocols TLSv1.1 TLSv1.2;
  ssl_ciphers "ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-SHA384:ECDHE-RSA-AES256-SHA384:ECDHE-ECDSA-AES128-SHA256:ECDHE-RSA-AES128-SHA256";

  location / {
    proxy_pass http://localhost:1880/ui/;
    proxy_set_header X-Real-IP $remote_addr;

    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
  }
 
  # emon_live, the new live dashboard (emon_Suite branch emon_live_ui, PLAN 2e): the
  # emon_live container on port 5003. Every URL its pages use is relative, so it works
  # under /live/ unchanged; the trailing slash on proxy_pass strips the prefix.
  # /live without the slash would resolve its relative URLs against /, so redirect it.
  location = /live {
    return 301 /live/;
  }

  location /live/ {
    proxy_pass http://localhost:5003/;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_http_version 1.1;
    proxy_set_header   Connection "";
  }

  location /grafana/ {
    proxy_pass http://192.168.1.131:3000/grafana/;
    proxy_set_header Host $http_host;
  }

#  location /birds/ {
#    proxy_pass http://192.168.1.133;
#    proxy_set_header Host $http_host;
#  }

    # /birds without the trailing slash leaves the browser resolving every
    # relative asset against /, so nothing loads. This redirect is essential.
    location = /birds {
        return 301 /birds/;
    }

    # Admin and remote-control surface, blocked at the edge. These need no
    # authentication by default: config.php rewrites birdnet.conf and restarts
    # services on POST, birdnet-status.php restarts units, cutout.php shells
    # out, /terminal is a writable web shell, and /scripts serves adminer.php,
    # a full database admin tool. Reach all of it on the LAN instead, at
    # http://192.168.1.133/ directly.
    location ~ ^/birds/(avian/api/(config|birdnet-status)\.php|terminal|scripts|phpsysinfo|Processed|log|stats)(/|$) {
        return 404;
    }

    # Live audio. icecast sends an endless response, so buffering must be off
    # or nginx accumulates it and the player never starts.
    location = /birds/stream {
        proxy_pass         http://192.168.1.133/stream;
        proxy_set_header   Host $host;
        proxy_buffering    off;
        proxy_read_timeout 24h;
    }

    location /birds/ {
        # The trailing slash strips the /birds/ prefix, so the container is
        # served as though at the root of its own host and the collage's
        # relative ./ URLs resolve correctly browser-side.
        proxy_pass http://192.168.1.133/;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Empty Connection header enables upstream keepalive on HTTP/1.1.
        # No $connection_upgrade map needed: nothing reachable here uses
        # WebSockets once /stats, /log and /terminal are blocked above.
        proxy_http_version 1.1;
        proxy_set_header   Connection "";

        # Chart and spectrogram regeneration is slow on a Pi under load.
        proxy_read_timeout 300s;
    }

  location /grafana2/ {
    proxy_pass http://192.168.1.111:3000;
    proxy_set_header Host $http_host;
  }

  location /other/ {
    proxy_pass http://192.168.1.121:1880/ui/;
#    proxy_pass http://node-red:1880/ui/;
  }
}


